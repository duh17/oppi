{
  "name": "related",
  "version": "0.42.0",
  "description": "Pi extension that publishes a related-work board with an agent-authored summary and navigable session/web items.",
  "type": "module",
  "license": "MIT",
  "author": "Chaos Donkey",
  "keywords": [
    "pi-package",
    "pi-extension",
    "oppi",
    "related"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duh17/oppi.git",
    "directory": "pi-extensions/related"
  },
  "bugs": "https://github.com/duh17/oppi/issues",
  "homepage": "https://github.com/duh17/oppi/tree/main/pi-extensions/related#readme",
  "files": [
    "extensions/",
    "index.ts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "check": "tsc --noEmit --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 --types node extensions/related.ts",
    "test": "vitest run extensions/related.test.ts"
  },
  "dependencies": {
    "typebox": "1.1.28"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.79.6",
