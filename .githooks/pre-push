#!/usr/bin/env bash
# Fast pre-push gate. Local work proves compilation/static correctness and runs
# change-related server tests. No CI runs full coverage: run
# `cd server && npm run test:gate:ci-coverage` and
# `clients/apple/scripts/check-coverage.sh`.
#
# Bypass: git push --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
# A real push runs the copy installed at <git common dir>/hooks/pre-push, a snapshot taken when it
# was installed, while this file is the one edited. The snapshot's self-test reads this file (it
# greps it and extracts its lane runner), so a snapshot older than the checkout runs its old
# fixtures against new code and fails the harness lane on a push this file passes when run by hand.
# Hand every push to this file, so an installed copy is a launcher that cannot drift from the
# checkout. The comparison is by content, not by path: $0 and this file can spell one path two ways
# (/var vs /private/var), and a path test would read a difference where the files are identical and
# hand off forever. OPPI_PRE_PUSH_DELEGATED is the one-shot breaker for a hand-off that still
# compares unequal (e.g. cmp is not on PATH): rather than loop, the copy runs as it is.
CHECKOUT_HOOK="$REPO_ROOT/.githooks/pre-push"
if [[ -z "${OPPI_PRE_PUSH_DELEGATED:-}" && -f "$0" && -f "$CHECKOUT_HOOK" ]] \
  && command -v cmp >/dev/null && ! cmp -s "$0" "$CHECKOUT_HOOK"; then
  export OPPI_PRE_PUSH_DELEGATED=1
  exec bash "$CHECKOUT_HOOK" "$@"
fi
SIM_POOL="$REPO_ROOT/clients/apple/scripts/sim-pool.sh"
HEAVY="$REPO_ROOT/scripts/heavy.sh"
PLANNER="$REPO_ROOT/scripts/pre-push-plan.ts"
GATE_VERSION="7"
ZERO_OID="0000000000000000000000000000000000000000"
CACHE_DIR="$(git rev-parse --git-dir)/oppi/pre-push-cache/v${GATE_VERSION}"
GIT_LOCAL_ENV_VARS="$(git rev-parse --local-env-vars)"

run_without_git_local_env() {
  (
    local name
    while IFS= read -r name; do
      [[ -n "$name" ]] && unset "$name"
    done <<< "$GIT_LOCAL_ENV_VARS"
    "$@"
  )
}

ensure_server_deps() {
  (cd "$REPO_ROOT/server" && node scripts/ensure-installed-deps.mjs)
}

# The busy-slot holder of run_self_test's slot fixture: create its release file, then stop the
# waiting shell under lockf and lockf itself. Globals, because the EXIT trap that also calls this
# runs after run_self_test's frame is gone. The holder stays in the hook's process group (no
# `set -m`: its setpgid can fail with EPERM and print to the lane), so a gate that stops the
# hook's group stops it too.
SELF_TEST_SLOT_HOLDER=""
SELF_TEST_SLOT_RELEASE=""
release_slot_holder() {
  [[ -n "$SELF_TEST_SLOT_HOLDER" ]] || return 0
  : > "$SELF_TEST_SLOT_RELEASE" 2>/dev/null || true
  pkill -TERM -P "$SELF_TEST_SLOT_HOLDER" 2>/dev/null || true
  kill -TERM "$SELF_TEST_SLOT_HOLDER" 2>/dev/null || true
  wait "$SELF_TEST_SLOT_HOLDER" 2>/dev/null || true
  SELF_TEST_SLOT_HOLDER=""
}

# --lanes-only: just the lane-runner fixtures below (seconds), not the suites and checks before them.
run_self_test() {
  # This self-test is the harness lane, which can run inside batch-gate.ts --with-pre-push. Its
  # fixtures fail lanes on purpose; their lane_event lines must never reach that gate's events file.
  # Nor may they take the Apple lane's slot signal or a slot an ancestor holds: each fixture's
  # apple_then_mac and heavy.sh calls set up their own. OPPI_HEAVY_PARENT_PID stays: a fixture's
  # queued heavy.sh job should give up when the hook is gone.
  # OPPI_PRE_PUSH_DELEGATED too: the fixtures push into their own repositories, and a copy they
  # install there must hand that push over, not read the breaker that got this hook here.
  unset OPPI_PRE_PUSH_EVENTS APPLE_SLOT_SIGNAL OPPI_HEAVY_HELD OPPI_PRE_PUSH_DELEGATED
  if [[ "${1:-}" != "--lanes-only" ]]; then
    bash -n "$REPO_ROOT/.githooks/pre-push" "$REPO_ROOT/clients/apple/scripts/check-coverage.sh" "$SIM_POOL" "$HEAVY"
    bun test "$REPO_ROOT/scripts/pre-push-plan.test.ts" "$REPO_ROOT/scripts/heavy.test.ts" \
      "$REPO_ROOT/scripts/batch-gate.test.ts" "$REPO_ROOT/scripts/batch-gate-health.test.ts" \
      "$REPO_ROOT/scripts/gate-report.test.ts" "$REPO_ROOT/scripts/dev-docs-guard.test.ts"
    (cd "$REPO_ROOT/server" && npm exec --offline -- vitest run tests/testing-policy-gate.test.ts \
      --reporter=dot --silent=passed-only)
    "$SIM_POOL" self-test
  fi

  # Regression for run_cached status capture.
  # Bash suppresses set -e for a function invoked in an || / && list, so
  # `"$@" || status=$?` lets a later success hide an earlier gate failure.
  demo_gate() { false; echo "gate-continued"; }
  local demo_status=0
  demo_gate >/dev/null || demo_status=$?
  [[ "$demo_status" -eq 0 ]] || {
    echo "pre-push self-test: expected bash || set -e quirk (status 0); got $demo_status" >&2
    exit 1
  }
  # Safe pattern: nested shell with set -e, not part of || / &&.
  set +e
  (
    set -euo pipefail
    demo_gate
  ) >/dev/null
  demo_status=$?
  set -e
  [[ "$demo_status" -ne 0 ]] || {
    echo "pre-push self-test: nested set -e shell should preserve early failure" >&2
    exit 1
  }
  if grep -nE '^[[:space:]]*\"\$@\" \|\| status=\$\?' "$REPO_ROOT/.githooks/pre-push" >/dev/null; then
    echo "pre-push self-test: the lane runner must not capture status with \"\$@\" || status=\$?" >&2
    exit 1
  fi
  # Callers must not put run_cached or apple_then_mac in an ||, &&, !, or if/while/until test
  # either: that disables set -e inside its nested shell and a lane's early failure is lost.
  # (Bracketed operators keep this check from matching its own source; comment lines are
  # ignored. A backslash-continued || on the next line is not caught.)
  if grep -vE '^[[:space:]]*#' "$REPO_ROOT/.githooks/pre-push" \
    | grep -E -e '(run_cached|apple_then_mac).*[|][|]' -e '(run_cached|apple_then_mac).*[&][&]' \
      -e '![[:space:]]*(run_cached|apple_then_mac)' \
      -e '(if|while|until)[[:space:]]+(run_cached|apple_then_mac)' >/dev/null; then
    echo "pre-push self-test: the lane runners must not be called from a logical list or if-test" >&2
    exit 1
  fi

  # Regression for the real run_cached/apple_then_mac: a lane whose first step fails and
  # whose last step succeeds must fail the lane, and Mac must not start after it.
  local lane_fixture lane_src lane_status
  lane_fixture="$(mktemp -d -t oppi-pre-push-lane.XXXXXX)"
  lane_src="$(awk '/^(lane_event|run_cached|with_apple_slot|wait_for_apple_slot|apple_then_mac)\(\) \{/,/^\}/' "$REPO_ROOT/.githooks/pre-push")"
  # Name every helper the fixtures rely on: a pattern that stops covering one of them leaves the
  # eval'd runner calling an undefined function, which reads as a broken lane, not a broken extract.
  case "$lane_src" in
    *'lane_event() {'*'run_cached() {'*'with_apple_slot() {'*'wait_for_apple_slot() {'*'apple_then_mac() {'*) ;;
    *)
      echo "pre-push self-test: could not extract every lane-runner function the fixtures eval" >&2
      exit 1
      ;;
  esac
  # The fixture subshell must not sit in an || / && list: that would disable the very
  # set -e behavior under test. Capture its status with the set +e pattern used above.
  set +e
  (
    set -euo pipefail
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=1
    run_apple_gate() { false; echo apple-continued >> "$lane_fixture/trace"; }
    run_mac_gate() { echo mac-ran >> "$lane_fixture/trace"; }
    run_ios_unit_gate() { echo unit-ran >> "$lane_fixture/trace"; }
    run_ios_release_gate() { true; }
    apple_then_mac & wait "$!"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  [[ "$lane_status" -ne 0 && ! -e "$lane_fixture/trace" && ! -e "$lane_fixture/apple.pass" ]] || {
    echo "pre-push self-test: a failing Apple build must fail apple_then_mac before Mac or unit tests and without a cache marker" >&2
    exit 1
  }
  # Unit tests fail while the Mac compile is still running: the lane fails only after Mac ends.
  set +e
  (
    set -euo pipefail
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=1
    run_apple_gate() { true; }
    run_mac_gate() { sleep 1; echo mac-ran >> "$lane_fixture/trace"; }
    run_ios_unit_gate() { false; echo unit-continued >> "$lane_fixture/trace"; }
    run_ios_release_gate() { true; }
    apple_then_mac & wait "$!"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  [[ "$lane_status" -ne 0 && "$(cat "$lane_fixture/trace")" == "mac-ran" && ! -e "$lane_fixture/ios-unit.pass" ]] || {
    echo "pre-push self-test: failing unit tests must fail apple_then_mac after the Mac compile ends" >&2
    exit 1
  }
  rm -f "$lane_fixture"/*
  # The same failure in the shape the hook really runs it: top-level set -euo pipefail and EXIT
  # trap, `apple_then_mac & PIDS+=("$!")`, waited on later. The lane must return the unit
  # status only after the Mac compile ended, with nothing like "unbound variable" on stderr.
  printf '%s\n' "$lane_src" > "$lane_fixture/lane-src.sh"
  cat > "$lane_fixture/hook-shape.sh" <<'HOOK_SHAPE'
set -euo pipefail
trap ':' EXIT
source "$LANE_FIXTURE/lane-src.sh"
ensure_lane_clean() { return 0; }
cache_path() { echo "$LANE_FIXTURE/$1.pass"; }
MAC_CHANGED=1
run_apple_gate() { true; }
run_mac_gate() { sleep 1; echo mac-ran >> "$LANE_FIXTURE/trace"; }
run_ios_unit_gate() { return 7; }
run_ios_release_gate() { true; }
PIDS=()
apple_then_mac & PIDS+=("$!")
st=0
wait "${PIDS[0]}" || st=$?
echo "$st" > "$LANE_FIXTURE/lane-status"
cat "$LANE_FIXTURE/trace" > "$LANE_FIXTURE/trace-at-return" 2>/dev/null || true
HOOK_SHAPE
  LANE_FIXTURE="$lane_fixture" bash "$lane_fixture/hook-shape.sh" >/dev/null 2>"$lane_fixture/stderr" || true
  [[ "$(cat "$lane_fixture/lane-status" 2>/dev/null)" == "7" \
    && "$(cat "$lane_fixture/trace-at-return" 2>/dev/null)" == "mac-ran" ]] \
    && ! grep -q 'unbound variable' "$lane_fixture/stderr" || {
    echo "pre-push self-test: with the hook's call shape, a failing unit lane must return its status after the Mac compile ended, without shell errors" >&2
    cat "$lane_fixture/stderr" >&2 || true
    exit 1
  }
  rm -f "$lane_fixture"/*
  # The Mac compile fails while unit tests pass: the lane fails.
  set +e
  (
    set -euo pipefail
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=1
    run_apple_gate() { true; }
    run_mac_gate() { false; echo mac-continued >> "$lane_fixture/trace"; }
    run_ios_unit_gate() { true; }
    run_ios_release_gate() { true; }
    apple_then_mac & wait "$!"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  [[ "$lane_status" -ne 0 && ! -e "$lane_fixture/trace" && ! -e "$lane_fixture/mac.pass" ]] || {
    echo "pre-push self-test: a failing Mac compile must fail apple_then_mac" >&2
    exit 1
  }
  rm -f "$lane_fixture"/*
  # The Release device-SDK compile fails while unit tests and the Mac compile pass: the lane
  # fails after both ended, and only the lanes that passed record a marker.
  set +e
  (
    set -euo pipefail
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=1
    run_apple_gate() { true; }
    run_mac_gate() { sleep 1; echo mac-ran >> "$lane_fixture/trace"; }
    run_ios_unit_gate() { true; }
    run_ios_release_gate() { return 9; }
    apple_then_mac & wait "$!"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  [[ "$lane_status" -eq 9 && "$(cat "$lane_fixture/trace")" == "mac-ran" && ! -e "$lane_fixture/ios-release.pass" && -e "$lane_fixture/ios-unit.pass" ]] || {
    echo "pre-push self-test: a failing Release compile must fail apple_then_mac with its status after the other lanes ended" >&2
    exit 1
  }
  rm -f "$lane_fixture"/*
  set +e
  (
    set -euo pipefail
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=1
    run_apple_gate() { true; }
    run_mac_gate() { echo mac-ran >> "$lane_fixture/trace"; }
    run_ios_unit_gate() { true; }
    run_ios_release_gate() { true; }
    apple_then_mac & wait "$!"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  [[ "$lane_status" -eq 0 && "$(cat "$lane_fixture/trace")" == "mac-ran" && -e "$lane_fixture/mac.pass" && -e "$lane_fixture/ios-unit.pass" && -e "$lane_fixture/ios-release.pass" ]] || {
    echo "pre-push self-test: a passing Apple lane must run Mac, the Release compile, and the unit tests and record every marker" >&2
    exit 1
  }
  rm -f "$lane_fixture"/*
  # The Release compile starts while the iOS build runs, once that build holds its slot.
  mkdir -p "$lane_fixture/heavy"
  set +e
  (
    set -euo pipefail
    export OPPI_HEAVY_DIR="$lane_fixture/heavy"
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=0
    run_apple_gate() { with_apple_slot bash -c 'sleep 1; [[ -e "$0/release-started" ]]' "$lane_fixture"; }
    run_ios_unit_gate() { true; }
    run_ios_release_gate() { touch "$lane_fixture/release-started"; }
    apple_then_mac & wait "$!"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  [[ "$lane_status" -eq 0 && -e "$lane_fixture/apple.pass" ]] || {
    echo "pre-push self-test: the Release compile must start while the iOS build runs" >&2
    exit 1
  }
  rm -rf "${lane_fixture:?}"/*
  # With one of the two xcode-build slots busy elsewhere, the iOS build takes the free one first and
  # the early Release compile waits for it, though the Release lane starts first and the build
  # spends 0.5 s on its guards before asking (scripts/heavy.sh has no queue).
  # The holder marks slot-held from inside its lock; never probe the slot with lockf instead. A
  # probe without -k unlinks the slot file when it exits, so a holder that opened the file during
  # a probe then locks the deleted inode while every later probe finds a new file free: the
  # self-test spun there for 45 minutes in a land-queue gate. The holder has none of the lane's
  # output, gives up after 60 s, and release_slot_holder frees it here or from the EXIT trap, so
  # it can neither hang nor outlive the self-test.
  mkdir -p "$lane_fixture/heavy"
  SELF_TEST_SLOT_RELEASE="$lane_fixture/free-slot"
  trap release_slot_holder EXIT
  /usr/bin/lockf -k "$lane_fixture/heavy/xcode-build.0" /bin/bash -c \
    ': > "$1"; for ((i = 0; i < 600; i++)); do [[ -e "$0" ]] && exit 0; sleep 0.1; done' \
    "$lane_fixture/free-slot" "$lane_fixture/slot-held" </dev/null >/dev/null 2>&1 &
  SELF_TEST_SLOT_HOLDER="$!"
  local held_wait=0
  while [[ ! -e "$lane_fixture/slot-held" && "$held_wait" -lt 300 ]]; do sleep 0.1; held_wait=$((held_wait + 1)); done
  [[ -e "$lane_fixture/slot-held" ]] || {
    echo "pre-push self-test: the busy-slot holder did not take its xcode-build slot within 30 s" >&2
    exit 1
  }
  set +e
  (
    set -euo pipefail
    export OPPI_HEAVY_DIR="$lane_fixture/heavy" OPPI_HEAVY_POLL=1
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=0
    run_apple_gate() { sleep 0.5; with_apple_slot bash -c 'echo apple >> "$0/trace"; sleep 1' "$lane_fixture"; }
    run_ios_unit_gate() { true; }
    run_ios_release_gate() { "$HEAVY" xcode-build -- bash -c 'echo release >> "$0/trace"' "$lane_fixture"; }
    apple_then_mac & wait "$!"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  release_slot_holder
  trap - EXIT
  [[ "$lane_status" -eq 0 && "$(tr '\n' ' ' < "$lane_fixture/trace")" == "apple release " ]] || {
    echo "pre-push self-test: with one xcode-build slot busy, the iOS build must take the free slot before the early Release compile" >&2
    exit 1
  }
  rm -rf "${lane_fixture:?}"/*
  # A red iOS build still waits for the early Release compile, starts neither Mac nor the unit
  # tests, and fails with its own status even when Release fails too.
  set +e
  (
    set -euo pipefail
    eval "$lane_src"
    ensure_lane_clean() { return 0; }
    cache_path() { echo "$lane_fixture/$1.pass"; }
    MAC_CHANGED=1
    run_apple_gate() { return 5; }
    run_mac_gate() { echo mac-ran >> "$lane_fixture/trace"; }
    run_ios_unit_gate() { echo unit-ran >> "$lane_fixture/trace"; }
    run_ios_release_gate() { sleep 1; echo release-ran >> "$lane_fixture/trace"; return 9; }
    apple_then_mac & lane_pid="$!"
    lane_exit=0
    wait "$lane_pid" || lane_exit=$?
    cat "$lane_fixture/trace" > "$lane_fixture/trace-at-return"
    exit "$lane_exit"
  ) >/dev/null 2>&1
  lane_status=$?
  set -e
  [[ "$lane_status" -eq 5 && "$(cat "$lane_fixture/trace-at-return")" == "release-ran" && ! -e "$lane_fixture/apple.pass" && ! -e "$lane_fixture/ios-release.pass" ]] || {
    echo "pre-push self-test: a failing iOS build must wait for the early Release compile, skip Mac and unit tests, and fail with its own status" >&2
    exit 1
  }
  rm -rf "$lane_fixture"

  # Git exports repository-local variables to hooks. Those variables are required
  # above for planning and cache checks, but they must not escape into tests that
  # create independent temporary repositories.
  local git_env_fixture contaminant_git target_repo contaminated_status sanitized_status
  git_env_fixture="$(mktemp -d -t oppi-pre-push-git-env.XXXXXX)"
  contaminant_git="$git_env_fixture/contaminant.git"
  target_repo="$git_env_fixture/target"
  git init --bare --quiet "$contaminant_git"
  mkdir -p "$target_repo"
  set +e
  (
    export GIT_DIR="$contaminant_git"
    unset GIT_WORK_TREE
    cd "$target_repo"
    git init --quiet --initial-branch=main
    printf 'fixture\n' > tracked.txt
    git add tracked.txt
  ) >/dev/null 2>&1
  contaminated_status=$?
  (
    export GIT_DIR="$contaminant_git"
    unset GIT_WORK_TREE
    cd "$target_repo"
    run_without_git_local_env bash -c \
      "git init --quiet --initial-branch=main && printf 'fixture\\n' > tracked.txt && git add tracked.txt"
  ) >/dev/null 2>&1
  sanitized_status=$?
  set -e
  rm -rf "$git_env_fixture"
  [[ "$contaminated_status" -ne 0 ]] || {
    echo "pre-push self-test: contaminated Git-local environment should break temp git add" >&2
    exit 1
  }
  [[ "$sanitized_status" -eq 0 ]] || {
    echo "pre-push self-test: sanitized Git-local environment should allow temp git add" >&2
    exit 1
  }

  # Git runs the installed copy at <git common dir>/hooks/pre-push for a real push, and the fixtures
  # above read this file: an installed snapshot older than the checkout eval'd this file's lane
  # runner, so it failed the harness lane only inside a real push. The hook hands every push to the
  # checkout's copy; a copy that diverges from it must never run.
  local push_fixture push_status
  push_fixture="$(mktemp -d -t oppi-pre-push-install.XXXXXX)"
  set +e
  run_without_git_local_env bash -c '
    set -euo pipefail
    # Global git config must not reach this fixture: gpgsign would fail its commit, and a global
    # core.hooksPath would run a hook from there instead of the copy installed below, so the push
    # would pass without testing anything. core.hooksPath=.git/hooks keeps the relative $0 that a
    # main checkout gets.
    git init --bare --quiet "$1/remote.git"
    git init --quiet --initial-branch=main "$1/seed"
    cd "$1/seed"
    printf "fixture\n" > tracked.txt
    git add tracked.txt
    git -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit --quiet -m fixture
    # No hook is installed yet, so the seeding push runs only a global one, which it must not.
    git -c core.hooksPath=.git/hooks push --quiet "$1/remote.git" main
    mkdir -p .githooks .git/hooks
    cp "$2/.githooks/pre-push" .githooks/pre-push
    # The installed copy differs from the checkout copy in the one way git can see: a line just past
    # the guard that hands the push to the checkout copy, so only an installed copy that does not
    # hand it over reaches it. Appended lines cannot tell the copies apart: the gate exits early.
    mark="touch $(printf "%q" "$1/installed-ran")"
    guarded=""
    placed=""
    while IFS= read -r line; do
      printf "%s\n" "$line"
      if [[ -n "$guarded" && -z "$placed" && "$line" == "fi" ]]; then
        printf "%s\n" "$mark"
        placed=1
      fi
      if [[ "$line" == *CHECKOUT_HOOK=* ]]; then
        guarded=1
      fi
    done < "$2/.githooks/pre-push" > .git/hooks/pre-push
    [[ -n "$placed" ]] || {
      echo "installed-copy fixture: the hook has no delegation guard to anchor the marker after"
      exit 1
    }
    chmod +x .git/hooks/pre-push
    # A delete row has no range, so the gate returns at once and only the hook git runs is under test.
    git -c core.hooksPath=.git/hooks push --quiet "$1/remote.git" --delete main
  ' bash "$push_fixture" "$REPO_ROOT" >"$push_fixture/push.log" 2>&1
  push_status=$?
  set -e
  [[ "$push_status" -eq 0 && ! -e "$push_fixture/installed-ran" ]] || {
    echo "pre-push self-test: a real push must run the checkout's hook, not the installed copy" >&2
    sed 's/^/  /' "$push_fixture/push.log" >&2 || true
    exit 1
  }
  rm -rf "$push_fixture"

  echo "pre-push self-test passed."
}

if [[ "${1:-}" == "--self-test" ]]; then
  run_self_test "${2:-}"
  exit 0
fi

if [[ "${1:-}" == "--plan" ]]; then
  shift
  exec bun "$PLANNER" "$@"
fi

# Queued heavy.sh jobs give up when this hook is gone (e.g. killed by a timeout).
export OPPI_HEAVY_PARENT_PID="$$"
# Every sim-pool call below (Apple build, unit shards) queues for a simulator slot for the gate wait
# (sim-pool-ops.ts GATE_POOL_WAIT_SECONDS) instead of failing after a developer run's 60 s; an
# explicit OPPI_SIM_POOL_WAIT still wins. batch-gate.ts sets the same marker for its lanes.
export OPPI_SIM_POOL_GATE=1
REMOTE_NAME="${1:-origin}"
PATHS_FILE="$(mktemp -t oppi-pre-push-paths.XXXXXX)"
trap 'rm -f "$PATHS_FILE"' EXIT
HEAD_SHA="$(git rev-parse HEAD)"
BASE_SHA=""
PUSH_ROWS=0
MULTIPLE_BASES=0
RANGE_KEY_INPUT=""

append_range() {
  local base="$1"
  local tip="$2"
  git diff --name-only --diff-filter=ACMRD -z "$base" "$tip" >> "$PATHS_FILE"
  RANGE_KEY_INPUT+="${base}:${tip};"
  if [[ -z "$BASE_SHA" ]]; then
    BASE_SHA="$base"
  elif [[ "$BASE_SHA" != "$base" ]]; then
    MULTIPLE_BASES=1
  fi
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "${local_ref:-}" ]] || continue
  PUSH_ROWS=$((PUSH_ROWS + 1))
  [[ "$local_oid" != "$ZERO_OID" ]] || continue

  local_commit="$(git rev-parse "${local_oid}^{commit}" 2>/dev/null || true)"
  [[ -n "$local_commit" ]] || continue
  # A land queue gates its batch as refs/heads/land-queue/<batch>. The lanes that record a red lane
  # (unit-shards, the server lane; scripts/gate-report.ts) need that batch id, which the queue only
  # passes to batch-gate.
  if [[ -z "${LAND_QUEUE_BATCH:-}" && "$local_ref" == refs/heads/land-queue/* ]]; then
    export LAND_QUEUE_BATCH="${local_ref#refs/heads/land-queue/}"
  fi
  if [[ "$local_commit" != "$HEAD_SHA" ]]; then
    echo "pre-push: refusing to test non-HEAD ref $local_ref ($local_commit)." >&2
    echo "Push it from a worktree where that commit is checked out." >&2
    exit 1
  fi

  if [[ "$remote_oid" == "$ZERO_OID" ]]; then
    remote_main="$(git rev-parse --verify "refs/remotes/${REMOTE_NAME}/main" 2>/dev/null || true)"
    base="$(git merge-base "$local_commit" "$remote_main" 2>/dev/null || true)"
    if [[ -z "$base" ]]; then
      base="$(git hash-object -t tree /dev/null)"
    fi
  else
    base="$(git rev-parse "${remote_oid}^{commit}" 2>/dev/null || echo "$remote_oid")"
  fi
  append_range "$base" "$local_commit"
done

# Manual invocation has no stdin. Plan against the tracking main branch.
if [[ "$PUSH_ROWS" -eq 0 ]]; then
  remote_main="$(git rev-parse --verify "refs/remotes/${REMOTE_NAME}/main" 2>/dev/null || true)"
  if [[ -z "$remote_main" ]]; then
    base="$(git hash-object -t tree /dev/null)"
  else
    base="$remote_main"
  fi
  append_range "$base" "$HEAD_SHA"
fi

if [[ ! -s "$PATHS_FILE" ]]; then
  echo "pre-push: no changed files in pushed refs."
  exit 0
fi

SERVER_MODE="none"
APPLE_MODE="none"
MAC_CHANGED=0
HARNESS_CHANGED=0
DOCS_CHANGED=0
CHANGED_COUNT=0
PLAN_OUTPUT=""
if ! PLAN_OUTPUT="$(bun "$PLANNER" --paths0-file "$PATHS_FILE" --format shell)"; then
  echo "pre-push: planner failed." >&2
  exit 1
fi
while IFS='=' read -r key value; do
  case "$key" in
    SERVER_MODE) SERVER_MODE="$value" ;;
    APPLE_MODE) APPLE_MODE="$value" ;;
    MAC_CHANGED) MAC_CHANGED="$value" ;;
    HARNESS_CHANGED) HARNESS_CHANGED="$value" ;;
    DOCS_CHANGED) DOCS_CHANGED="$value" ;;
    CHANGED_COUNT) CHANGED_COUNT="$value" ;;
  esac
done <<< "$PLAN_OUTPUT"

case "$SERVER_MODE" in none|changed|full) ;; *) echo "pre-push: invalid server plan." >&2; exit 1 ;; esac
case "$APPLE_MODE" in none|unit|all) ;; *) echo "pre-push: invalid Apple plan." >&2; exit 1 ;; esac
[[ "$MAC_CHANGED" =~ ^[01]$ && "$HARNESS_CHANGED" =~ ^[01]$ && "$DOCS_CHANGED" =~ ^[01]$ && "$CHANGED_COUNT" =~ ^[1-9][0-9]*$ ]] || {
  echo "pre-push: incomplete planner output." >&2
  exit 1
}

if [[ "$MULTIPLE_BASES" -eq 1 && "$SERVER_MODE" == "changed" ]]; then
  SERVER_MODE="full"
fi

mkdir -p "$CACHE_DIR"
TOOLCHAIN_KEY="$(printf '%s\n' "$(bun --version)" "$(node --version)" "$(xcodebuild -version 2>/dev/null || true)" | shasum -a 256 | cut -d' ' -f1)"
PUSH_PATHS_KEY="$(shasum -a 256 "$PATHS_FILE" | cut -d' ' -f1)"

lane_has_dirty_paths() {
  local lane="$1"
  local dirty_file
  dirty_file="$(mktemp -t oppi-pre-push-dirty.XXXXXX)"
  git diff --name-only -z HEAD > "$dirty_file"
  git ls-files --others --exclude-standard -z >> "$dirty_file"
  if [[ ! -s "$dirty_file" ]]; then
    rm -f "$dirty_file"
    return 1
  fi

  local dirty_server="none" dirty_apple="none" dirty_mac=0 dirty_harness=0 dirty_plan=""
  if ! dirty_plan="$(bun "$PLANNER" --paths0-file "$dirty_file" --format shell)"; then
    echo "[$lane] dirty-path planner failed; blocking cache use." >&2
    rm -f "$dirty_file"
    return 0
  fi
  while IFS='=' read -r key value; do
    case "$key" in
      SERVER_MODE) dirty_server="$value" ;;
      APPLE_MODE) dirty_apple="$value" ;;
      MAC_CHANGED) dirty_mac="$value" ;;
      HARNESS_CHANGED) dirty_harness="$value" ;;
    esac
  done <<< "$dirty_plan"

  case "$dirty_server" in none|changed|full) ;; *) echo "[$lane] invalid dirty server plan." >&2; rm -f "$dirty_file"; return 0 ;; esac
  case "$dirty_apple" in none|unit|all) ;; *) echo "[$lane] invalid dirty Apple plan." >&2; rm -f "$dirty_file"; return 0 ;; esac
  if [[ ! "$dirty_mac" =~ ^[01]$ || ! "$dirty_harness" =~ ^[01]$ ]]; then
    echo "[$lane] incomplete dirty-path plan; blocking cache use." >&2
    rm -f "$dirty_file"
    return 0
  fi

  local overlaps=1
  case "$lane" in
    server) [[ "$dirty_server" != "none" ]] && overlaps=0 ;;
    apple) [[ "$dirty_apple" != "none" ]] && overlaps=0 ;;
    mac) [[ "$dirty_mac" -eq 1 ]] && overlaps=0 ;;
    harness) [[ "$dirty_harness" -eq 1 ]] && overlaps=0 ;;
    ios-unit|ios-release) [[ "$dirty_apple" != "none" ]] && overlaps=0 ;;
  esac

  if [[ "$overlaps" -eq 0 ]]; then
    echo "[$lane] relevant uncommitted paths prevent authoritative validation:" >&2
    while IFS= read -r -d '' path; do
      printf '  %q\n' "$path" >&2
    done < "$dirty_file"
  fi
  rm -f "$dirty_file"
  return "$overlaps"
}

ensure_lane_clean() {
  local lane="$1"
  if lane_has_dirty_paths "$lane"; then
    echo "[$lane] commit or move the relevant changes to another worktree before pushing." >&2
    return 1
  fi
}

cache_path() {
  local lane="$1"
  local lane_mode key
  case "$lane" in
    server) lane_mode="$SERVER_MODE" ;;
    apple|ios-unit) lane_mode="$APPLE_MODE $(apple_scheme)" ;;
    # These compile under the pinned Xcode, not the default `xcodebuild` that TOOLCHAIN_KEY names.
    ios-release) lane_mode="$APPLE_MODE $(pinned_xcode_version)" ;;
    mac) lane_mode="$MAC_CHANGED $(pinned_xcode_version)" ;;
    harness) lane_mode="$HARNESS_CHANGED" ;;
  esac
  key="$(printf '%s\n' "$GATE_VERSION" "$HEAD_SHA" "$RANGE_KEY_INPUT" "$PUSH_PATHS_KEY" "$lane" "$lane_mode" "$TOOLCHAIN_KEY" | shasum -a 256 | cut -d' ' -f1)"
  echo "$CACHE_DIR/${lane}-${key}.pass"
}

# One line per lane outcome (`<lane> passed|failed|cache-hit`) appended to $OPPI_PRE_PUSH_EVENTS
# when it is set. scripts/batch-gate.ts --with-pre-push runs this hook alongside its own lanes and
# reads the file: `apple` passing starts its UI lanes, and any failure stops them at once.
lane_event() {
  if [[ -n "${OPPI_PRE_PUSH_EVENTS:-}" ]]; then
    printf '%s %s\n' "$1" "$2" >> "$OPPI_PRE_PUSH_EVENTS"
  fi
}

run_cached() {
  local lane="$1"
  shift
  local marker status=0
  # Remember caller errexit: we must toggle set -e around the lane without
  # permanently changing the caller's option state.
  local caller_errexit=0
  [[ $- == *e* ]] && caller_errexit=1
  ensure_lane_clean "$lane" || { status=$?; lane_event "$lane" failed; return "$status"; }
  marker="$(cache_path "$lane")"
  if [[ -f "$marker" ]]; then
    echo "[$lane] cache hit"
    lane_event "$lane" cache-hit
    return 0
  fi
  echo "[$lane] starting"
  # Run the lane in a nested shell with set -e. Do not use `"$@" || status=$?`:
  # bash disables set -e for the duration of a command in an || / && list, including
  # function bodies, so a later success (npm test) can hide prettier failures.
  # A plain `set +e; "$@"; status=$?` is also wrong: with set +e the function
  # continues after failures and returns the last command's status.
  # `if "$@"; then` / `if (set -e; "$@"); then` are also wrong: if-tests suppress
  # set -e inside the condition, including nested shells and function bodies.
  set +e
  (
    set -euo pipefail
    "$@"
  )
  status=$?
  if [[ "$caller_errexit" -eq 1 ]]; then
    set -e
  else
    set +e
  fi
  [[ "$status" -eq 0 ]] || { lane_event "$lane" failed; return "$status"; }
  ensure_lane_clean "$lane" || { status=$?; lane_event "$lane" failed; return "$status"; }
  : > "$marker.tmp.$$"
  mv "$marker.tmp.$$" "$marker"
  echo "[$lane] passed"
  lane_event "$lane" passed
}

run_harness_gate() {
  run_self_test
}

run_server_gate() {
  (cd "$REPO_ROOT/server" && npm run check:server)
  # The classic entries of these built-in plugins keep `bun test` suites, which Vitest excludes
  # (server/vitest.config.ts); together they take a few seconds.
  local plugin
  for plugin in background-jobs subagents; do
    (cd "$REPO_ROOT/server/plugins/$plugin" && run_without_git_local_env bun test --silent)
  done
  local log_dir test_log
  # Absolute: the suites below run from server/, and the log redirect resolves there.
  # Common dir, not the per-worktree git dir: the land queue deletes a batch worktree (and
  # its private git dir) after the gate, and the log must outlive it to explain a red lane.
  log_dir="$(git rev-parse --path-format=absolute --git-common-dir)/oppi/pre-push-logs"
  mkdir -p "$log_dir"
  # mktemp, not the bare timestamp: the folder is shared by every worktree, and two lanes started
  # in the same second would open (and truncate) one file. BSD mktemp wants the X's last.
  test_log="$(mktemp "$log_dir/server-$(date +%Y%m%d-%H%M%S)-XXXXXX")"
  echo "[server] test log: $test_log"

  local started="$SECONDS"
  set +e
  if [[ "$SERVER_MODE" == "full" ]]; then
    # One full suite machine-wide. The log redirect lives inside the slot so heavy.sh's
    # "slots busy; waiting" notice reaches the hook's stderr, not the log.
    (cd "$REPO_ROOT/server" && run_without_git_local_env \
      "$HEAVY" server-full -- bash -c 'exec "$@" >"$0" 2>&1' "$test_log" \
      npm test -- --reporter=dot --silent=passed-only)
  else
    (cd "$REPO_ROOT/server" && run_without_git_local_env \
      npm exec --offline -- vitest run --changed "$BASE_SHA" --passWithNoTests \
      --reporter=dot --silent=passed-only) >"$test_log" 2>&1
  fi
  local status=$?
  set -e
  local seconds=$((SECONDS - started))
  # Wall time against dev/testing/lane-budgets.json; over budget is a warning, never a failure.
  (cd "$REPO_ROOT" && run_without_git_local_env bun scripts/gate-report.ts budget server "$seconds") || true

  if [[ "$status" -ne 0 ]]; then
    # In a land-queue batch, one row in the red-lane ledger with a cause guessed from the log.
    (cd "$REPO_ROOT" && run_without_git_local_env bun scripts/gate-report.ts red-lane \
      --lane server --exit "$status" --seconds "$seconds" --log "$test_log") || true
    # Name the failures in the gate output itself: the log path may not be readable by whoever
    # reads the gate log. Capped so a flood of failures cannot bury it; the full log has the rest.
    local fail_lines="" max_fail_lines=40
    echo "[server] tests failed (exit $status)" >&2
    if [[ -s "$test_log" ]]; then
      fail_lines="$(sed -E $'s/\x1b\\[[0-9;]*m//g' "$test_log" | grep -E '^ FAIL ' || true)"
      if [[ -n "$fail_lines" ]]; then
        # Here-strings, not pipes: under pipefail an early-exiting head would SIGPIPE the writer.
        head -n "$max_fail_lines" <<< "$fail_lines" >&2
        local fail_count
        fail_count="$(wc -l <<< "$fail_lines" | tr -d ' ')"
        if [[ "$fail_count" -gt "$max_fail_lines" ]]; then
          echo "[server] ... $((fail_count - max_fail_lines)) more FAIL lines in the log" >&2
        fi
      else
        # No test FAIL line (crash, unhandled error, runner failure): show the log tail instead.
        tail -n 30 "$test_log" >&2
      fi
      sed -E $'s/\x1b\\[[0-9;]*m//g' "$test_log" \
        | grep -E '^ Test Files|^      Tests|^     Errors|^   Duration' >&2 || true
    else
      # The runner never wrote the log (e.g. the heavy.sh wrapper failed before its redirect).
      echo "[server] no test output was captured" >&2
    fi
    echo "[server] full log: $test_log" >&2
    return "$status"
  fi
  grep -E '^ Test Files|^      Tests|^   Duration' "$test_log" || true
  # A green lane has nothing to explain; only red logs stay in the shared folder.
  rm -f "$test_log"
}

run_apple_gate() {
  # A stale or misnamed accessibility id in the app or a UI/E2E test: a source scan, about
  # 0.6 s, so it runs here for every Apple-lane push (the build phase's architecture check
  # only re-runs when its watched app sources change, not when a test does).
  (cd "$REPO_ROOT" && run_without_git_local_env bun scripts/ax-id-guard.ts) || return $?
  # The edit-entry scan reads app sources the build phase's stamp does not watch, so a change
  # to the guard or to one reader's bar would otherwise pass unpushed. About 0.1 s.
  (cd "$REPO_ROOT" && run_without_git_local_env bun scripts/document-edit-guard.ts) || return $?
  # sim-pool builds without a simulator slot. The lane takes the machine-wide xcode-build slot for
  # it (with_apple_slot), so sim-pool, seeing OPPI_HEAVY_HELD, takes no second one.
  (cd "$REPO_ROOT/clients/apple" && with_apple_slot "$SIM_POOL" run -- \
    xcodebuild -project Oppi.xcodeproj -scheme "$(apple_scheme)" build-for-testing)
}

# Run "$@" in a heavy.sh xcode-build slot, first marking $APPLE_SLOT_SIGNAL/held: the early Release
# compile (apple_then_mac) asks for a slot only once the iOS Debug build holds one, so on a busy
# machine Release never takes the last free slot from the build every other lane waits for.
with_apple_slot() {
  "$HEAVY" xcode-build -- bash -c ': > "$0/held"; exec "$@"' "${APPLE_SLOT_SIGNAL:?}" "$@"
}

# Until the iOS Debug build holds its xcode-build slot, or its lane ended without one (a guard
# failed, a cache hit). Never the other way round, so the two cannot wait on each other.
wait_for_apple_slot() {
  while [[ ! -e "${APPLE_SLOT_SIGNAL:?}/held" && ! -e "$APPLE_SLOT_SIGNAL/done" ]]; do sleep 0.2; done
}

# The scheme the Apple lane builds: Oppi (every test target) when UI or E2E code changed, or when
# the batch gate that runs this hook (batch-gate.ts --with-pre-push) has UI or E2E lanes that will
# test this build (OPPI_PRE_PUSH_UI_LANES=1); else OppiUnitTests. Both build OppiTests, and the unit
# shards run from this same build.
apple_scheme() {
  if [[ "$APPLE_MODE" == "all" || "${OPPI_PRE_PUSH_UI_LANES:-0}" == "1" ]]; then echo Oppi; else echo OppiUnitTests; fi
}

# Every OppiTests test, in OPPI_UNIT_SHARDS (3) pool slots (~3.5 min). The shards build the scheme
# the Apple lane just built, so sim-pool skips the build ("nothing changed") and the shards need no
# xcode-build slot: they never wait behind the Mac and Release compiles. A build of the other
# scheme would also rewrite .build/dd's products and make every later Oppi build (the batch UI
# and E2E lanes) re-link.
run_ios_unit_gate() {
  (cd "$REPO_ROOT/clients/apple" && bun scripts/unit-shards.ts --scheme "$(apple_scheme)")
}

# Xcode named in clients/apple/scripts/xcode-toolchain.txt (an explicit DEVELOPER_DIR wins), the one
# every Oppi build lane uses. Never touches xcode-select.
pinned_developer_dir() {
  (
    source "$REPO_ROOT/clients/apple/scripts/xcode-toolchain.sh"
    oppi_use_xcode_toolchain
    printf '%s' "$DEVELOPER_DIR"
  )
}

# The pinned Xcode's version, for the cache keys of the lanes that build with it.
pinned_xcode_version() {
  DEVELOPER_DIR="$(pinned_developer_dir)" xcodebuild -version 2>/dev/null | tr '\n' ' '
}

# Device-SDK Release compile of the app. The Debug build above never sees code behind
# `#if DEBUG`, so a Release-only break (a DEBUG-only member used from shared code) would
# pass every lane and fail the first archive. DerivedData is private to this lane and
# incremental, so a push that changed little recompiles little.
run_ios_release_gate() {
  local developer_dir log_dir build_log status=0 cache_arg
  local -a cache_args=()
  developer_dir="$(pinned_developer_dir)"
  # sim-pool's shared SwiftPM clone and compilation cache, keyed by this Xcode: a fresh worktree
  # compiles from the cache instead of from source, and clones no packages over the network.
  while IFS= read -r -d '' cache_arg; do cache_args+=("$cache_arg"); done < <(
    DEVELOPER_DIR="$developer_dir" bun "$REPO_ROOT/clients/apple/scripts/xcode-cache-args.ts" "$REPO_ROOT/clients/apple/.build/pre-push-release"
  )
  log_dir="$(git rev-parse --absolute-git-dir)/oppi/pre-push-logs"
  mkdir -p "$log_dir"
  build_log="$log_dir/ios-release-$(date +%Y%m%d-%H%M%S).log"
  echo "[ios-release] build log: $build_log"
  # A worktree the land queue keeps between batches would otherwise grow one log (~3 MB) per gate.
  local old_log
  while IFS= read -r old_log; do rm -f "$old_log"; done < <(ls -t "$log_dir"/ios-release-*.log 2>/dev/null | tail -n +10)
  set +e
  (cd "$REPO_ROOT/clients/apple" && DEVELOPER_DIR="$developer_dir" \
    "$HEAVY" xcode-build -- xcodebuild \
    -project Oppi.xcodeproj -scheme Oppi -configuration Release \
    -sdk iphoneos -destination 'generic/platform=iOS' \
    -derivedDataPath .build/pre-push-release \
    CODE_SIGNING_ALLOWED=NO ${cache_args[@]+"${cache_args[@]}"} build) >"$build_log" 2>&1
  status=$?
  set -e
  if [[ "$status" -ne 0 ]]; then
    echo "[ios-release] Release device-SDK build failed (exit $status); inspect $build_log" >&2
    grep -E 'error:' "$build_log" | sort -u | head -20 >&2 || true
    return "$status"
  fi
  grep -E '\*\* BUILD' "$build_log" || true
}

run_mac_gate() {
  (cd "$REPO_ROOT/server" && bun scripts/check-architecture-boundaries.ts --scope mac)
  (cd "$REPO_ROOT/clients/apple" && DEVELOPER_DIR="$(pinned_developer_dir)" "$HEAVY" xcode-build -- xcodebuild \
    -project Oppi.xcodeproj -scheme OppiMac build-for-testing \
    -destination 'platform=macOS' \
    -derivedDataPath .build/pre-push-mac \
    CODE_SIGNING_ALLOWED=NO)
}

echo "pre-push: $CHANGED_COUNT changed paths; server=$SERVER_MODE apple=$APPLE_MODE mac=$MAC_CHANGED harness=$HARNESS_CHANGED docs=$DOCS_CHANGED"

# Cheap repo-wide invariant that no lane owns: tracked source and configuration
# must not record an absolute home directory. It runs on every push because an
# iOS-only or doc-only change otherwise never reaches the server lane, and a
# stale home path only fails later, at runtime. See
# server/scripts/check-home-paths.ts.
if ! run_without_git_local_env bun "$REPO_ROOT/server/scripts/check-home-paths.ts"; then
  echo "pre-push: absolute home paths in tracked files; see the list above." >&2
  exit 1
fi

# Contributor docs stay to the standard in dev/README.md ("What belongs in dev/"): word budgets
# (dev/doc-budgets.json) and a paragraph limit. A doc-only push plans no lane, so it runs here,
# like the home-path check: a second or so, whenever a dev/ doc, the budgets, or the guard changed.
if [[ "$DOCS_CHANGED" -eq 1 ]]; then
  if ! run_without_git_local_env bun "$REPO_ROOT/scripts/dev-docs-guard.ts"; then
    echo "pre-push: dev/ docs outside their budgets; see the list above." >&2
    exit 1
  fi
fi

# The Apple build runs the server's architecture rules in a build phase, so it needs them too.
if [[ "$SERVER_MODE" != "none" || "$HARNESS_CHANGED" -eq 1 || "$APPLE_MODE" != "none" ]]; then
  # Install server deps from this worktree's lockfile before any lane starts, so
  # lanes never race on node_modules. Fails the hook if deps cannot be synced.
  if ! run_without_git_local_env ensure_server_deps; then
    echo "[server] FAILED: server dependencies are not in sync with package-lock.json." >&2
    exit 1
  fi
fi

# The Release device-SDK compile (whole-module, ~5 min, the gate's longest compile) needs only the
# sources, so it starts during the iOS Debug build, as soon as that build holds its xcode-build
# slot (the Debug build gates every other lane, so it gets the first claim). After that build, the Mac compile (~50 s) and the
# sharded iOS unit tests (~3.5 min) join it, overlapping the server lane. A failed iOS build skips
# Mac and the unit tests, and the lane still waits for the Release compile and ends with the iOS
# build's status.
# Keep run_cached out of || / && / if-tests here: they disable set -e inside its nested
# shell (see run_cached). The Apple build runs in a nested `set -e` shell whose status is read
# under set +e, so a failure is kept, never swallowed. The other lanes run in the background so
# run_cached keeps set -e for its own marker write; their statuses are captured at `wait`
# (set +e / status=$?) and the function returns only after all of them ended, so a failed lane
# never leaves another running. An EXIT trap cannot do that wait: it runs after the function
# frame is gone, so a `local` PID is already unbound under set -u.
apple_then_mac() {
  local mac_pid="" unit_pid release_pid apple_status=0 unit_status=0 release_status=0 mac_status=0
  local APPLE_SLOT_SIGNAL
  APPLE_SLOT_SIGNAL="$(mktemp -d -t oppi-pre-push-apple-slot.XXXXXX)"
  export APPLE_SLOT_SIGNAL
  # The Debug build gets the first claim on an xcode-build slot (with_apple_slot).
  (
    wait_for_apple_slot
    run_cached ios-release run_ios_release_gate
  ) & release_pid="$!"
  set +e
  (
    set -euo pipefail
    run_cached apple run_apple_gate
  )
  apple_status=$?
  : > "$APPLE_SLOT_SIGNAL/done"
  if [[ "$apple_status" -ne 0 ]]; then
    wait "$release_pid"
    rm -rf "$APPLE_SLOT_SIGNAL"
    set -e
    return "$apple_status"
  fi
  set -e
  # The Apple build above already built the unit products (run_ios_unit_gate), so the shards need
  # no xcode-build slot and start at once, beside the Mac and Release compiles that take the slots.
  run_cached ios-unit run_ios_unit_gate & unit_pid="$!"
  if [[ "$MAC_CHANGED" -eq 1 ]]; then
    run_cached mac run_mac_gate & mac_pid="$!"
  fi
  set +e
  wait "$unit_pid"
  unit_status=$?
  wait "$release_pid"
  release_status=$?
  if [[ -n "$mac_pid" ]]; then
    wait "$mac_pid"
    mac_status=$?
  fi
  rm -rf "$APPLE_SLOT_SIGNAL"
  set -e
  # Every lane has ended. The first failure in this order is the lane's status; the
  # others report themselves in their logs.
  [[ "$unit_status" -eq 0 ]] || return "$unit_status"
  [[ "$release_status" -eq 0 ]] || return "$release_status"
  return "$mac_status"
}

PIDS=()
LANES=()
if [[ "$HARNESS_CHANGED" -eq 1 ]]; then
  run_cached harness run_harness_gate & PIDS+=("$!"); LANES+=("harness")
fi
if [[ "$SERVER_MODE" != "none" ]]; then
  run_cached server run_server_gate & PIDS+=("$!"); LANES+=("server")
fi
if [[ "$APPLE_MODE" != "none" ]]; then
  apple_then_mac & PIDS+=("$!")
  if [[ "$MAC_CHANGED" -eq 1 ]]; then LANES+=("apple+mac"); else LANES+=("apple"); fi
elif [[ "$MAC_CHANGED" -eq 1 ]]; then
  run_cached mac run_mac_gate & PIDS+=("$!"); LANES+=("mac")
fi

FAILED=0
for index in "${!PIDS[@]}"; do
  if ! wait "${PIDS[$index]}"; then
    echo "[${LANES[$index]}] FAILED" >&2
    FAILED=1
  fi
done

if [[ "$FAILED" -ne 0 ]]; then
  echo "Pre-push gate FAILED." >&2
  exit 1
fi

echo "Pre-push gate passed. It does not run full coverage; no CI does either."
echo "Full coverage: cd server && npm run test:gate:ci-coverage; clients/apple/scripts/check-coverage.sh"
