Subject: [PATCH 2/8] iOS: libgodot create/destroy, rendering layer helpers,
 SDL shims

---
 core/extension/libgodot.h    |  19 +++++
 platform/ios/libgodot_ios.mm | 142 +++++++++++++++++++++++++++++++++++
 2 files changed, 161 insertions(+)
 create mode 100644 platform/ios/libgodot_ios.mm

diff --git a/core/extension/libgodot.h b/core/extension/libgodot.h
index 17d0753..7d165a0 100644
--- a/core/extension/libgodot.h
+++ b/core/extension/libgodot.h
@@ -70,6 +70,25 @@ LIBGODOT_API GDExtensionObjectPtr libgodot_create_godot_instance(int p_argc, cha
  */
 LIBGODOT_API void libgodot_destroy_godot_instance(GDExtensionObjectPtr p_godot_instance);
 
+/**
+ * iOS only. Rendering layer helpers for a host that draws Godot into its own
+ * view. Create on the main thread after creating the instance (the driver is
+ * known then) and before `start`; the result is a +1 retained CALayer. Hand it
+ * to the display server with `DisplayServerAppleEmbedded::set_host_layer`.
+ * Start and stop wrap each iteration (the OpenGL layer binds and presents).
+ */
+LIBGODOT_API void *libgodot_ios_create_rendering_layer(const char *p_rendering_driver);
+LIBGODOT_API void libgodot_ios_initialize_rendering_layer(void *p_rendering_layer);
+LIBGODOT_API void libgodot_ios_layout_rendering_layer(void *p_rendering_layer);
+LIBGODOT_API void libgodot_ios_start_rendering_layer(void *p_rendering_layer);
+LIBGODOT_API void libgodot_ios_stop_rendering_layer(void *p_rendering_layer);
+
+/**
+ * iOS only. Called right after the OS singleton exists, before setup reads
+ * the project, so a host can add loggers that see setup's own errors.
+ */
+LIBGODOT_API void libgodot_ios_set_os_created_callback(void (*p_callback)(void));
+
 #ifdef __cplusplus
 }
 #endif // __cplusplus
diff --git a/platform/ios/libgodot_ios.mm b/platform/ios/libgodot_ios.mm
