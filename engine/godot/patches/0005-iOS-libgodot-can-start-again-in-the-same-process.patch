+++ b/core/string/string_name.cpp
@@ -47,13 +47,23 @@ struct StringName::Table {
 
 void StringName::setup() {
 	ERR_FAIL_COND(configured);
+#ifndef LIBGODOT_ENABLED
 	for (uint32_t i = 0; i < Table::TABLE_LEN; i++) {
 		Table::table[i] = nullptr;
 	}
+#endif
 	configured = true;
 }
 
 void StringName::cleanup() {
+#ifdef LIBGODOT_ENABLED
+	// A host may start another engine in this process. Static StringNames
+	// (SNAME, class names) outlive this one and keep pointing into the
+	// table, so the table stays for the next engine, which finds the same
+	// names in it. Until then nothing unreferences, so nothing is freed.
+	configured = false;
+	return;
+#endif
 	MutexLock lock(Table::mutex);
 
