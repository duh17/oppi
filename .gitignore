!scripts/apple-warnings.ts
!scripts/apple-warnings.test.ts
!scripts/apple-warnings-baseline.json
!scripts/file-line-budget-baseline.json
!scripts/pre-push-plan.ts
!scripts/pre-push-plan.test.ts
!scripts/heavy.sh
!scripts/heavy.test.ts
!scripts/batch-gate.ts
!scripts/batch-gate.test.ts
!scripts/batch-gate-health.test.ts
!scripts/gate-report.ts
!scripts/gate-report.test.ts
!scripts/dev-docs-guard.ts
!scripts/dev-docs-guard.test.ts
!scripts/deps-check.ts
!scripts/deps-check.test.ts
!scripts/sim-pool.sh
server/scripts/manual/*
!server/scripts/manual/telemetry-import-sqlite.mjs

