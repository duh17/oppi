# Dependencies and build outputs
node_modules/
server/dist/
# Copied from server/package-lock.json by prepack, removed by postpack.
server/npm-shrinkwrap.json
server/coverage/
clients/apple/build/
clients/apple/.build
# Built by clients/apple/scripts/build-tailscalekit.sh (exceeds the repo file-size limit).
clients/apple/Vendor/TailscaleKit/
# Locally built, pinned static terminal engine.
clients/apple/Vendor/GhosttyVt/
# The Godot pane's engine, built locally by engine/godot/build.sh and
# installed by clients/apple/scripts/install-oppi-godot.sh; never committed.
clients/apple/Vendor/OppiGodot/
clients/apple/docs/
# Generated by clients/apple/scripts/generate-project.sh (Xcode Cloud: ci_scripts/ci_post_clone.sh);
# its Swift package pins are tracked in clients/apple/Package.resolved.
clients/apple/*.xcodeproj/
*.xcuserstate
*.tsbuildinfo
*.tgz

# Tracked script allowlists
scripts/*
!scripts/release/
!scripts/release/**
!scripts/apple-container-copy-run.sh
!scripts/duplication-scan.ts
!scripts/document-edit-guard.ts
!scripts/scroll-offset-guard.ts
!scripts/theme-surface-guard.ts
!scripts/uikit-structure-guard.ts
