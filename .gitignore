!clients/apple/Oppi.xcodeproj/
!clients/apple/Oppi.xcodeproj/**
clients/apple/Oppi.xcodeproj/**/xcuserdata/
*.xcuserstate
*.tsbuildinfo
*.tgz

# Tracked script allowlists
scripts/*
!scripts/apple-container-copy-run.sh
!scripts/duplication-scan.ts
!scripts/scroll-offset-guard.ts
!scripts/theme-surface-guard.ts
clients/apple/scripts/*
!clients/apple/scripts/release-mac.sh
!clients/apple/scripts/periphery-scan.ts
!clients/apple/scripts/ipad-shell-diagnostic.sh
server/scripts/manual/*
!server/scripts/manual/telemetry-import-sqlite.mjs

# Local/private workspace data
.github/*
!.github/workflows/
.github/workflows/*
