    "contract.ts",
    "agent-message.ts",
    "wakers.ts",
    "widget.ts",
    "README.md",
    "package.json"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
