{
  "name": "oppi-server",
  "version": "0.1.0",
  "description": "Self-hosted server for the Oppi mobile coding agent",
  "type": "module",
  "main": "dist/src/cli.js",
  "bin": {
    "oppi": "dist/src/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "extensions/",
    "!extensions/**/*.test.ts",
    "themes/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duh17/oppi.git",
    "directory": "server"
  },
  "homepage": "https://github.com/duh17/oppi/tree/main/server#readme",
  "bugs": "https://github.com/duh17/oppi/issues",
  "license": "MIT",
  "author": "Da Chen",
  "keywords": [
    "coding-agent",
    "mobile",
    "cli",
    "llm",
    "anthropic",
    "claude"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/src/cli.js",
    "prepare": "tsc && chmod +x dist/src/cli.js",
    "dev": "tsx watch src/cli.ts serve",
    "start": "node dist/src/cli.js serve",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "bench": "npm run bench:correctness && npm run bench:perf:gate",
    "bench:perf": "npm run bench:hotpath",
    "bench:perf:gate": "tsx bench/run-gate.ts --suite hotpath --runs 3 --metric-set avg --max-regression-pct 15 --min-baseline-us 0.2 --max-absolute-regression-us 0.05",
    "bench:correctness": "npm run check && npm test",
    "bench:gate": "npm run bench",
    "bench:hotpath": "tsx bench/server-hotpath.bench.ts",
    "bench:hotpath:gate": "npm run bench:correctness && tsx bench/run-gate.ts --suite hotpath --runs 3 --metric-set avg --max-regression-pct 15 --min-baseline-us 0.2 --max-absolute-regression-us 0.05",
    "bench:compare": "tsx bench/compare-metrics.ts",
    "lint": "eslint src/ extensions/ bench/",
    "lint:fix": "eslint src/ extensions/ bench/ --fix",
    "format": "prettier --write --ignore-unknown src/ extensions/ bench/",
    "format:check": "prettier --check --ignore-unknown src/ extensions/ bench/",
    "telemetry:import": "node scripts/manual/telemetry-import-sqlite.mjs",
    "telemetry:import:watch": "node scripts/manual/telemetry-import-sqlite.mjs --watch",
    "telemetry:grafana:up": "docker compose -f docker-compose.telemetry.yml up -d",
    "telemetry:grafana:down": "docker compose -f docker-compose.telemetry.yml down",
    "telemetry:review": "bun scripts/telemetry-review.ts",
    "telemetry:review:gate": "bun scripts/telemetry-review.ts --days 3 --gate",
    "dead-code": "knip",
    "test:gate:pr-fast": "bun scripts/testing-gates.ts pr-fast",
    "test:gate:nightly-deep": "bun scripts/testing-gates.ts nightly-deep",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:clean": "node scripts/e2e-clean.mjs",
    "test:e2e:pairing": "vitest run --config vitest.e2e.config.ts e2e/pairing-flow",
    "test:e2e:session": "vitest run --config vitest.e2e.config.ts e2e/paired-session",
    "test:e2e:paired-compat": "npm run test:e2e:clean && E2E_NATIVE=1 vitest run --config vitest.e2e.config.ts e2e/paired-session",
    "test:e2e:auth-connection": "npm run test:e2e:clean && E2E_NATIVE=1 vitest run --config vitest.e2e.config.ts e2e/pairing-flow e2e/paired-session", 
    "test:e2e:linux": "vitest run --config vitest.e2e.config.ts",
    "check": "bash -c 'pids=(); tsc --noEmit & pids+=($!); eslint src/ extensions/ bench/ & pids+=($!); knip & pids+=($!); prettier --check --ignore-unknown src/ extensions/ bench/ & pids+=($!); rc=0; for p in \"${pids[@]}\"; do wait \"$p\" || rc=1; done; exit $rc'"
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.7.0",
    "@mariozechner/pi-coding-agent": "0.70.6",
    "diff-match-patch": "^1.0.5",
    "mime-types": "3.0.2",
    "typebox": "1.1.28",
    "ws": "^8.18.0"
  },
  "overrides": {
    "basic-ftp": "^5.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/mime-types": "3.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^5.83.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
