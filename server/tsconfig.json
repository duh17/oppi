{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "resolveJsonModule": true,
    "paths": {
      "oppi/v1": ["./src/oppi-v1.ts"],
      "oppi/v1/schema": ["./src/oppi-v1-schema.ts"]
    }
  },
  "include": ["src/**/*", "plugins/*/server.ts", "plugins/auto-name/index.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/__tests__/**"]
}
