    "add": {
      "title": "Add MCP Server",
      "submit": {
        "title": "Add",
        "action": "add",
        "requires": [
          "name",
          "url",
          "command"
        ]
      },
      "sections": [
        {
          "id": "configuration",
          "header": "Configuration",
          "namesHost": true,
          "rows": [
            {
              "kind": "field",
              "id": "name",
              "placeholder": "Server name"
            },
            {
              "kind": "value",
              "id": "scope",
              "label": "Scope",
              "value": "Global"
            },
            {
              "kind": "choice",
              "id": "transport",
              "label": "Transport",
              "value": "http",
              "options": [
                {
                  "value": "http",
                  "title": "HTTP"
                },
                {
                  "value": "stdio",
                  "title": "stdio"
                }
              ]
            },
            {
              "kind": "choice",
              "id": "exposure",
              "label": "Exposure",
              "value": "codemode",
              "options": [
                {
                  "value": "codemode",
                  "title": "Code Mode",
                  "footer": "Scripts find and call tools; the model doesn't see them."
                },
                {
                  "value": "deferred",
                  "title": "Deferred",
                  "footer": "Tool search loads matching tools into the model context."
                },
                {
                  "value": "direct",
                  "title": "Direct",
                  "footer": "Tools are always declared to the model."
                },
                {
                  "value": "hidden",
                  "title": "Hidden",
                  "footer": "Tools cannot be called."
                }
              ]
            }
          ]
        },
        {
          "id": "http",
          "header": "Streamable HTTP",
          "footer": "Use ${NAME} references instead of literal secrets. For example: API_KEY=${TOOLS_KEY}, or Authorization=Bearer ${TOKEN}. Values are resolved on the host; literal values are redacted when read back.",
          "when": {
            "field": "transport",
            "is": "http"
          },
          "rows": [
            {
              "kind": "field",
              "id": "url",
              "placeholder": "https://example.com/mcp",
              "input": "url"
            },
            {
              "kind": "field",
              "id": "headers",
              "placeholder": "Headers: one KEY=VALUE per line",
              "input": "multiline"
            }
          ]
        },
        {
          "id": "oauth",
          "header": "Optional OAuth Client",
          "when": {
            "field": "transport",
            "is": "http"
          },
          "rows": [
            {
              "kind": "field",
              "id": "clientId",
              "placeholder": "Client ID"
            },
            {
              "kind": "field",
              "id": "clientSecret",
              "placeholder": "Client secret reference: ${NAME}"
            },
            {
              "kind": "field",
              "id": "callbackPort",
              "placeholder": "Callback port (automatic if empty)",
              "input": "number"
            }
          ]
        },
        {
          "id": "stdio",
          "header": "Standard Input / Output",
          "footer": "Use ${NAME} references instead of literal secrets. For example: API_KEY=${TOOLS_KEY}, or Authorization=Bearer ${TOKEN}. Values are resolved on the host; literal values are redacted when read back.\nAdding a command authorizes Pi to run it on the host when the scope is trusted and the server is enabled.",
          "when": {
            "field": "transport",
            "is": "stdio"
          },
          "rows": [
            {
              "kind": "field",
              "id": "command",
              "placeholder": "Executable (not a shell command)"
            },
            {
              "kind": "field",
              "id": "arguments",
              "placeholder": "Arguments: one per line (no secrets)",
              "input": "multiline"
            },
            {
              "kind": "field",
              "id": "cwd",
              "placeholder": "Working directory (optional)"
            },
            {
              "kind": "field",
              "id": "environment",
              "placeholder": "Environment: one KEY=VALUE per line",
              "input": "multiline"
            }
          ]
        }
      ]
    },
