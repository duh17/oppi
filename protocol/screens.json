              "kind": "choice",
              "id": "exposure",
              "label": "Exposure",
              "value": "codemode",
              "options": [
                {
                  "value": "codemode",
                  "title": "Code Mode",
                  "footer": "Scripts find and call tools; the model doesn't see them."
                },
                {
                  "value": "deferred",
                  "title": "Deferred",
                  "footer": "Tool search loads matching tools into the model context."
                },
                {
                  "value": "direct",
                  "title": "Direct",
                  "footer": "Tools are always declared to the model."
                },
                {
                  "value": "hidden",
                  "title": "Hidden",
                  "footer": "Tools cannot be called."
