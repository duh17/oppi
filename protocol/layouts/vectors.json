{
  "version": 1,
  "description": "Pane layout documents (docs/layouts.md) and what the validator makes of each: the canonical layout and its warnings, the problems that refuse it, or a newer version. Issues compare by code and path, in order; messages are each validator's own. inputText is raw JSON text, for cases a parsed value cannot show.",
  "vectors": [
    {
      "name": "worked example: chat beside a panel over a file",
      "input": {
        "$schema": "https://oppi.chat/schema/layout-1.json",
        "v": 1,
        "title": "Review auth fix",
        "root": {
          "split": "row",
          "weights": [
            0.42,
            0.58
          ],
          "children": [
            {
              "pane": "chat",
              "chat": "self"
            },
            {
              "split": "column",
              "weights": [
                0.46,
                0.54
              ],
              "children": [
                {
                  "pane": "agents",
                  "panel": "widget:subagents"
                },
                {
                  "pane": "code",
                  "file": "server/src/storage/device-auth.ts",
                  "line": 208
                }
              ]
            }
          ]
        },
        "focus": "chat"
      },
      "expect": "valid",
      "layout": {
        "v": 1,
        "title": "Review auth fix",
        "root": {
          "split": "row",
          "weights": [
            0.42,
            0.58
          ],
          "children": [
            {
              "pane": "chat",
              "chat": "self"
            },
            {
              "split": "column",
              "weights": [
                0.46,
                0.54
              ],
              "children": [
                {
                  "pane": "agents",
                  "panel": "widget:subagents"
                },
                {
                  "pane": "code",
                  "file": "server/src/storage/device-auth.ts",
                  "line": 208
