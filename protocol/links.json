      "server": null,
      "route": { "kind": "browser", "url": "http://mac-studio:5173/game?level=2&mode=hard#start" },
      "canonical": "oppi://browser?url=http://mac-studio:5173/game%3Flevel%3D2%26mode%3Dhard%23start"
    },
    {
      "name": "browser link names its server",
      "input": "oppi://browser?url=https%3A%2F%2Fexample.com%2F&server=sha256:9f86d081884c7d65",
      "server": "sha256:9f86d081884c7d65",
      "route": { "kind": "browser", "url": "https://example.com/" },
      "canonical": "oppi://browser?url=https://example.com/&server=sha256:9f86d081884c7d65"
    },
    {
      "name": "browser link at the 2 KiB limit",
