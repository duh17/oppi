    },
    {
      "name": "browser link without a url",
      "input": "oppi://browser",
      "error": { "code": "missing", "detail": "url" }
    },
    {
      "name": "browser link to a javascript: URL",
      "input": "oppi://browser?url=javascript%3Aalert(1)",
      "error": { "code": "invalidValue", "detail": "url" }
    },
    {
      "name": "browser link to a file: URL",
      "input": "oppi://browser?url=file%3A%2F%2F%2Fetc%2Fpasswd",
      "error": { "code": "invalidValue", "detail": "url" }
    },
    {
      "name": "browser link with a user name and password",
      "input": "oppi://browser?url=https%3A%2F%2Falex%3Asecret%40example.com%2F",
      "error": { "code": "invalidValue", "detail": "url" }
    },
    {
      "name": "browser link to localhost",
      "input": "oppi://browser?url=http%3A%2F%2Flocalhost%3A5173%2F",
      "error": { "code": "invalidValue", "detail": "url" }
    },
    {
