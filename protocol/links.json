      "input": "oppi://browser?url=http%3A%2F%2F127.1%3A5173%2F",
      "error": { "code": "invalidValue", "detail": "url" }
    },
    {
      "name": "browser link to IPv6 loopback",
      "input": "oppi://browser?url=http%3A%2F%2F%5B%3A%3A1%5D%3A5173%2F",
      "error": { "code": "invalidValue", "detail": "url" }
    },
    {
      "name": "browser link whose page query was not escaped",
      "input": "oppi://browser?url=https://example.com/?a=1&b=2",
      "error": { "code": "unknownParameter", "detail": "b" }
    },
    {
      "name": "browser link with a fragment of its own",
      "input": "oppi://browser?url=https%3A%2F%2Fexample.com%2F#top",
      "error": { "code": "unexpectedComponent", "detail": "fragment" }
    },
    {
      "name": "terminal links keep their own parser",
      "input": "oppi://terminal/rex?session=session:1&block=block:2",
      "notPaneLink": true
    },
    {
      "name": "pairing invites are not pane links",
      "input": "oppi://connect?v=3&invite=abc",
      "notPaneLink": true
    },
    {
      "name": "workspace links are not pane links",
      "input": "oppi://workspace?path=/srv/project/code&name=Code",
