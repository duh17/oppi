<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Oppi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>dev.chenda.oppi.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oppi</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_oppi._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Oppi uses the camera to scan pairing QR codes and take photos for agent conversations.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Oppi uses Face ID to unlock the app when App Lock is on, to confirm new or changed servers, and to approve protected actions like removing a server or setting an API key.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Oppi needs local network access to connect to your paired self-hosted server.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Oppi uses the microphone to transcribe your voice into text prompts.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Oppi saves images from agent conversations to your photo library.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Oppi accesses your photo library to attach photos and videos to agent conversations.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Oppi uses on-device speech recognition to convert your voice into text.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>OPPITelemetryMode</key>
	<string>$(OPPI_TELEMETRY_MODE)</string>
	<key>UIAppFonts</key>
	<array>
		<string>FiraCode-Regular.ttf</string>
		<string>FiraCode-SemiBold.ttf</string>
		<string>FiraCode-Bold.ttf</string>
		<string>JetBrainsMono-Regular.ttf</string>
		<string>JetBrainsMono-SemiBold.ttf</string>
		<string>JetBrainsMono-Bold.ttf</string>
		<string>CascadiaCode-Regular.ttf</string>
		<string>CascadiaCode-SemiBold.ttf</string>
		<string>CascadiaCode-Bold.ttf</string>
		<string>SourceCodePro-Regular.otf</string>
		<string>SourceCodePro-Semibold.otf</string>
		<string>SourceCodePro-Bold.otf</string>
		<string>MonaspaceNeon-Regular.otf</string>
		<string>MonaspaceNeon-SemiBold.otf</string>
		<string>MonaspaceNeon-Bold.otf</string>
		<string>SymbolsNerdFontMono-Regular.ttf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
